PORT=3210
KB_DATA_DIR=./var
# Required: generated by npm run setup. Back up separately from the database.
KB_MASTER_KEY=
KB_OLLAMA_URL=http://127.0.0.1:11434
KB_MODEL=qwen2.5:3b
KB_MODEL_TIMEOUT_MS=120000
KB_TESSERACT=tesseract
KB_OCR_LANG=eng
# Optional: both are needed for explicitly queued LGU submissions.
KB_SYNC_URL=
KB_SYNC_TOKEN=
# Optional receiver: shared secret and the single LGU accepted by this instance.
KB_INBOUND_SYNC_TOKEN=
KB_INBOUND_LGU=
# Enable only behind a local HTTPS reverse proxy.
KB_SECURE_COOKIE=false
